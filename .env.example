# xAI key for live Grok interrogation (server-only; never commit a real value).
XAI_API_KEY=
# Optional: model override (default grok-4.20-0309-non-reasoning).
XAI_MODEL=
# HMAC key for signing the game-state token; use a long random string (e.g. `openssl rand -hex 32`). If unset, one is derived from XAI_API_KEY.
GAME_STATE_SECRET=

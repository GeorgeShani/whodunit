# xAI key for live Grok interrogation (server-only; never commit a real value).
XAI_API_KEY=
# Optional: model override (default grok-4.20-0309-non-reasoning).
XAI_MODEL=
# Optional: HMAC key for the signed game-state token (>= 16 chars).
# If unset, a key is derived one-way from XAI_API_KEY.
GAME_STATE_SECRET=

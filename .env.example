# xAI key for live Grok interrogation (server-only; never commit a real value).
XAI_API_KEY=
# Optional: model override (default grok-4.20-0309-non-reasoning).
XAI_MODEL=
# HMAC key for signing the game-state token; use a long random string (e.g. `openssl rand -hex 32`). If unset, one is derived from XAI_API_KEY.
GAME_STATE_SECRET=
# Cost protection (docs/OPERATIONS.md). Defaults shown; leave unset to use them.
# MODEL_DISABLED=1            # kill switch: no model calls at all
# MODEL_RATE_LIMIT=20         # model turns per IP per window (a confrontation exchange = 2)
# MODEL_RATE_WINDOW_SECONDS=600
# MODEL_DAILY_CAP=300         # model turns per UTC day, all players
# Optional: Postgres for the permanent closed-games record (#39, docs/OPERATIONS.md). Use the Supabase TRANSACTION pooler
# URI (port 6543). Unset = cache-only record (best effort). Apply migrations with `npm run db:migrate`.
DATABASE_URL=
